DATABASE_URL=postgresql+psycopg://mta:replace-this-password@localhost:5432/mta_apps
POSTGRES_PASSWORD=replace-this-password
ADMIN_API_TOKEN=replace-with-a-long-random-secret
CORS_ORIGINS=https://www.mtahqq.dpdns.org,https://mtahqq.dpdns.org
APPLE_COUNTRY=us
APPLE_SEARCH_TERMS=browser,office,photo,video,education,security,finance,communication,developer,utilities,messaging,maps,health,weather
WINGET_SEARCH_TERMS=browser,office,photo,video,education,security,finance,communication,developer,utilities
APPLE_LIMIT=100
WINGET_LIMIT=24
FLATHUB_MAX_APPS=1000
CATALOG_CONCURRENCY=6

# Expanded public catalogue connectors
FIREFOX_ADDON_PAGES=3
WORDPRESS_PLUGIN_PAGES=3
# Optional Google Play metadata via AppBrain (API key required)
APPBRAIN_API_KEY=
# AppBrain browse page count per category (1-11; each page can consume API credits)
APPBRAIN_MAX_PAGES=1
APPBRAIN_IOS_MAX_PAGES=1
# Enable only after confirming remaining AppBrain credits
APPBRAIN_ENABLE_IOS=false

# Free public catalogue sources (no API keys)
BLUEJETTY_MAX_APPS=200000
BLUEJETTY_PAGE_DELAY=0.55
OPENUSE_MAX_APPS=50000

# Chocolatey is queried only via its supported CLI on Windows runners.
CHOCOLATEY_PAGE_SIZE=1000
CHOCOLATEY_MAX_PAGES=10

# WinGet community index pagination
WINGET_LIMIT=24
WINGET_PAGES=3
