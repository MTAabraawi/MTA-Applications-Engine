{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mta-applications-engine",
  "main": "worker.py",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["python_workers"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_CONFIG_ID"
    }
  ]
}
