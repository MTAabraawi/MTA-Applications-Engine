{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mta-applications-engine",
  "main": "worker.js",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "CATALOGUE_STORAGE": "github",
    "GITHUB_CATALOGUE_BRANCH": "main"
  }
}
